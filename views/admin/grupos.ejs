<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Admin - Grupos</title>
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="page-admin">

  <header class="admin-topbar">
    <div class="at-left">
      <span class="logo-mini">G</span>
      <div>
        <b>Panel de examenes</b>
        <span class="muted">Grupos y dias de examen</span>
      </div>
    </div>
    <nav class="at-nav">
      <a href="/admin/panel" class="btn btn-ghost">Panel</a>
      <a href="/admin/alumnos" class="btn btn-ghost">Alumnos</a>
      <a href="/admin/grupos" class="btn btn-ghost activo">Grupos</a>
      <a href="/admin/instituciones" class="btn btn-ghost">Instituciones</a>
      <a href="/admin/preguntas" class="btn btn-ghost">Preguntas</a>
      <form method="POST" action="/admin/logout" style="display:inline">
        <button type="submit" class="btn btn-ghost">Salir</button>
      </form>
    </nav>
  </header>

  <main class="admin-main">
    <% if (ok) { %><div class="alert alert-ok"><%= ok %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <section class="card-form">
      <h2>Nuevo grupo</h2>

      <form method="POST" action="/admin/grupos">
        <div class="dos-col">
          <div>
            <label for="grNombre">Nombre</label>
            <input type="text" id="grNombre" name="nombre" required maxlength="60"
                   placeholder="Ej: Sabado manana" />
          </div>
          <div>
            <label for="grDia">Dia de examen</label>
            <select id="grDia" name="dia" required>
              <% dias.forEach(function(d) { %>
                <option value="<%= d.n %>" <%= d.n === 6 ? 'selected' : '' %>><%= d.label %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="dos-col">
          <div>
            <label for="grDesde">Hora de inicio</label>
            <input type="time" id="grDesde" name="hora_desde" value="10:00" required />
          </div>
          <div>
            <label for="grHasta">Hora de fin</label>
            <input type="time" id="grHasta" name="hora_hasta" value="14:00" required />
          </div>
        </div>
        <div class="acciones-form">
          <button type="submit" class="btn btn-primary">Crear grupo</button>
        </div>
      </form>
    </section>

    <section class="card-tabla" style="margin-top:20px">
      <div class="tabla-titulo">
        <h2>Grupos cargados</h2>
        <span class="pill"><%= grupos.length %></span>
      </div>

      <% if (grupos.length === 0) { %>
        <p class="muted">No hay grupos. Crea el primero con el formulario.</p>
      <% } else { %>
        <div class="scroll-tabla">
          <table class="tabla">
            <thead>
              <tr>
                <th>Nombre</th>
                <th>Dia</th>
                <th>Horario</th>
                <th>Alumnos</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% grupos.forEach(function(g) { %>
                <tr data-id="<%= g.id %>">
                  <td><b><%= g.nombre %></b></td>
                  <td><%= (dias.find(function(d) { return d.n === g.dia; }) || {}).label || g.dia %></td>
                  <td><%= g.hora_desde %> a <%= g.hora_hasta %></td>
                  <td><%= g.alumnos %></td>
                  <td class="c-acciones">
                    <button type="button" class="btn btn-sm btn-ghost btn-editar">Editar</button>
                    <form method="POST" action="/admin/grupos/<%= g.id %>/borrar" class="form-borrar" style="display:inline">
                      <button type="submit" class="btn btn-sm btn-danger">Borrar</button>
                    </form>
                  </td>
                </tr>
                <tr class="fila-edicion" hidden>
                  <td colspan="5">
                    <form method="POST" action="/admin/grupos/<%= g.id %>/editar" class="form-editar" style="margin:0; border:0; padding:0">
                      <div class="fila-form fila-grupo">
                        <input type="text" name="nombre" value="<%= g.nombre %>" required maxlength="60" aria-label="Nombre del grupo" />
                        <select name="dia" aria-label="Dia de examen">
                          <% dias.forEach(function(d) { %>
                            <option value="<%= d.n %>" <%= d.n === g.dia ? 'selected' : '' %>><%= d.label %></option>
                          <% }) %>
                        </select>
                        <input type="time" name="hora_desde" value="<%= g.hora_desde %>" required aria-label="Hora de inicio" />
                        <input type="time" name="hora_hasta" value="<%= g.hora_hasta %>" required aria-label="Hora de fin" />
                        <button type="submit" class="btn btn-sm btn-primary">Guardar</button>
                        <button type="button" class="btn btn-sm btn-ghost btn-cancelar-edicion">Cancelar</button>
                      </div>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <p class="muted pie-tabla">
          Cada alumno pertenece a un grupo. El examen solo se puede iniciar dentro del dia y horario del grupo.
        </p>
      <% } %>
    </section>
  </main>

  <div class="toast" id="toast" hidden></div>

  <script src="/js/admin.js"></script>
</body>
</html>
